# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: The CANONICAL domain (no trailing slash). Used for canonical tags,
# Open Graph URLs, JSON-LD schema, and the generated sitemap.xml + robots.txt.
# Must match your production domain to avoid split SEO signals.
VITE_SITE_URL="https://lucanatackle.com"

# VITE_WHATSAPP_PHONE: The target phone number with country code for receiving WhatsApp orders.
VITE_WHATSAPP_PHONE="+1234567890"

